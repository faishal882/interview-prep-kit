# Required: only GEMINI_API_KEY. Everything else optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional public-discussion search
SEARCH_API_KEY=
# Server / jobs
ENV=production
ALLOW_PRIVATE_URLS=false
MONGODB_URI=
SESSION_SECRET=change-me
ALLOWED_ORIGINS=
MAX_CRAWL_PAGES=12
CRAWL_DEPTH=2
MAX_CONCURRENT_RUNS=2
# Local telemetry demo only
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=trao-api
DEBUG_CAPTURE_CONTENT=false
# Tests / offline
FAKE_LLM=
