# Required in production (startup refuses to start without them).
GEMINI_API_KEY=
MONGODB_URI=mongodb://127.0.0.1:27017
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Database name (optional).
MONGODB_DB=trao
# Model choice (optional).
GEMINI_MODEL=gemini-2.0-flash
# Explicit fake-model switch for tests/offline only. Never set in production.
FAKE_LLM=
# Optional public-discussion search.
SEARCH_API_KEY=
# Server / jobs.
ENV=production
ALLOW_PRIVATE_URLS=false
MAX_CRAWL_PAGES=12
CRAWL_DEPTH=2
MAX_CONCURRENT_RUNS=2
# Registration is closed by default; provision users with the operator command.
# Set true only to explicitly reopen self-service registration.
REGISTRATION_OPEN=false
SESSION_TTL_S=604800
# Quotas (per user; adjustable).
MAX_KITS_PER_DAY=10
MAX_STORED_KITS=50
MAX_CONCURRENT_PER_USER=1
# Request limits (adjustable).
MAX_JD_CHARS=30000
MAX_BODY_BYTES=1048576
MAX_BATCH_ENTRIES=10
# Generation deadlines in seconds (adjustable).
STEP_TIMEOUT_S=60
OVERALL_TIMEOUT_S=180
# Shared model quota (adjustable).
LLM_REQUESTS_PER_MINUTE=60
LLM_TOKENS_PER_MINUTE=200000
# Retrieval cache.
PAGE_CACHE_TTL_S=3600
# Local telemetry demo only.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=trao-api
DEBUG_CAPTURE_CONTENT=false
